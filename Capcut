<!DOCTYPE html><html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HappyMod Lite</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f5f5f5;
    }
    header {
      background-color: #4CAF50;
      color: white;
      padding: 1rem;
      text-align: center;
    }
    .search-box {
      margin: 1rem;
      text-align: center;
    }
    .search-box input {
      padding: 0.5rem;
      width: 80%;
      max-width: 400px;
      border-radius: 5px;
      border: 1px solid #ccc;
    }
    .app-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1rem;
    }
    .app-card {
      background-color: white;
      border-radius: 10px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      padding: 1rem;
      display: flex;
      gap: 1rem;
      align-items: center;
    }
    .app-card img {
      width: 80px;
      height: 80px;
      border-radius: 15px;
      object-fit: cover;
    }
    .app-details {
      flex-grow: 1;
    }
    .app-details h3 {
      margin: 0;
      font-size: 1.2rem;
    }
    .app-details p {
      margin: 0.5rem 0;
      font-size: 0.9rem;
      color: #444;
    }
    .download-btn {
      background-color: #4CAF50;
      color: white;
      padding: 0.5rem 1rem;
      border: none;
      border-radius: 5px;
      text-decoration: none;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <header>
    <h1>HappyMod Lite</h1>
  </header>  <div class="search-box">
    <input type="text" placeholder="Search apps... (not functional yet)" />
  </div>  <div class="app-list">
    <div class="app-card">
      <img src="https://www.google.com/images/branding/product/2x/play_prism_96dp.png" alt="CapCut Icon" />
      <div class="app-details">
        <h3>CapCut v14.3.0</h3>
        <p>CapCut is a free, all-in-one video editing app by ByteDance (the creators of TikTok), available on Android, iOS, and desktop. It offers a range of tools ideal for content creators on TikTok, Instagram, and YouTube.</p>
      </div>
      <a class="download-btn" href="https://files.modyolo.com/CapCut/CapCut_v14.3.0.apk" target="_blank">Download</a>
    </div>
  </div>
</body>
</html>
